# Copy to `.env.local` for local development. Production values go in the host UI (Vercel, etc.) — never commit secrets.

# Required: browser-visible API origin (no trailing slash). Production MUST be HTTPS.
NEXT_PUBLIC_API_URL=http://localhost:5013

# --- Split production (Hawana Airways) — use ONE block per deployed Next.js project ---

# (A) Public website build → https://hawanaairways.com
# NEXT_PUBLIC_API_URL=https://api.hawanaairways.com
# NEXT_PUBLIC_SITE_URL=https://hawanaairways.com
# NEXT_PUBLIC_CANONICAL_HOST=hawanaairways.com
# NEXT_PUBLIC_BACKOFFICE_LOGIN_URL=https://hams.hawanaairways.com/login

# (B) HAMS operations build → https://hams.hawanaairways.com
# NEXT_PUBLIC_API_URL=https://api.hawanaairways.com
# NEXT_PUBLIC_SITE_URL=https://hams.hawanaairways.com
# NEXT_PUBLIC_CANONICAL_HOST=hams.hawanaairways.com

# (C) Vercel preview/production (e.g. hams-frontend.vercel.app)
# Direct API (requires https://api.hawanaairways.com DNS + live backend):
# NEXT_PUBLIC_API_URL=https://api.hawanaairways.com
# NEXT_PUBLIC_SITE_URL=https://hams-frontend.vercel.app
# NEXT_PUBLIC_CANONICAL_HOST=hams-frontend.vercel.app

# (D) Path B — Railway API + Vercel proxy (required until api.hawanaairways.com DNS is live):
# HAMS_BACKEND_INTERNAL_URL=https://YOUR-SERVICE.up.railway.app
# NEXT_PUBLIC_USE_API_PROXY=true
# NEXT_PUBLIC_API_URL=/api
# NEXT_PUBLIC_SITE_URL=https://hams.hawanaairways.com
# NEXT_PUBLIC_CANONICAL_HOST=hams.hawanaairways.com
# Railway FRONTEND_URL=https://hams.hawanaairways.com,https://hams-frontend.vercel.app

# Staging examples (separate DB + secrets):
# NEXT_PUBLIC_SITE_URL=https://hams-staging.hawanaairways.com
# NEXT_PUBLIC_CANONICAL_HOST=hams-staging.hawanaairways.com
