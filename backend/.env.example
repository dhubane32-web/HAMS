# Default 5000. On macOS, if port 5000 is taken by AirPlay Receiver, set PORT=5013 and NEXT_PUBLIC_API_URL to match.
PORT=5000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/hams
# Production: minimum 32 characters (validated at startup).
JWT_SECRET=replace_with_secure_secret
# Session lifetime for JWT (e.g. 1h, 8h). Production default is 1h if unset.
# JWT_EXPIRES_IN=1h
# Comma-separated origins (production). Dev allows any localhost port regardless.
# Comma-separated browser origins (required in production for CORS + mutation origin checks). Include Next dev URL.
FRONTEND_URL=http://localhost:3000,http://localhost:3001,http://localhost:3030
# Production (Hawana Airways split): public + HAMS + optional www — exact scheme/host/port:
# FRONTEND_URL=https://hawanaairways.com,https://www.hawanaairways.com,https://hams.hawanaairways.com,https://hams-frontend.vercel.app
# Optional extra browser origins (comma-separated), e.g. preview URLs:
# HAMS_EXTRA_CORS_ORIGINS=https://hams-frontend-git-main-dhubane32-web.vercel.app
# Staging API should list only staging web origins, not production.
# AES-256-GCM key for TOTP secrets at rest. Production: required, min 32 characters.
# HAMS_ENCRYPTION_KEY=change_me_to_a_long_random_string_at_least_32_chars
# Login lockout after failed attempts (defaults: 5 tries, 30 minute lock).
# HAMS_LOGIN_MAX_FAILED=5
# HAMS_LOGIN_LOCK_MINUTES=30
# API rate limits (optional overrides).
# HAMS_RATE_LIMIT_MAX=600
# HAMS_AUTH_LOGIN_MAX=25
# Password reset email abuse (per IP, per hour window).
# HAMS_AUTH_RESET_MAX=8
# HAMS_AUTH_RESET_WINDOW_MS=3600000
# Set to false to skip per-request DB user/role check (emergency only).
# HAMS_STRICT_SESSION=true
# Set true to issue httpOnly session cookie (use with CORS credentials + bearerFromCookie).
# HAMS_HTTPONLY_SESSION=false
# Force password rotation after N days (0 = disabled).
# HAMS_PASSWORD_MAX_AGE_DAYS=90
# Max multipart body size hint for future uploads (bytes).
# HAMS_MAX_UPLOAD_BYTES=8388608
# Optional: restrict /api/system* to these IPs/CIDRs (comma-separated).
# ADMIN_IP_ALLOWLIST=203.0.113.10,198.51.100.0/24
# Optional: trusted machine clients (must send X-HAMS-Client: trusted + this header).
# HAMS_INTERNAL_API_KEY=

# Optional: e-ticket email (POST /api/booking/.../documents/tickets/:id/email)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Hawana Airways <noreply@hawana.aero>"

# --- Production backups (see docs/PRODUCTION_HAWANA_AIRWAYS.md) ---
# BACKUP_SCHEDULER_ENABLED=true
# BACKUP_ENCRYPTION_KEY=<32+ chars, unique secret>
# BACKUP_ROOT_DIR=/var/lib/hams/backups
# BACKUP_DAILY_HOUR_UTC=2
# BACKUP_OFFSITE_PROVIDER=none
# BACKUP_RETENTION_DAILY_DAYS=30
# BACKUP_RETENTION_WEEKLY_DAYS=90
# BACKUP_RETENTION_MONTHLY_DAYS=365
# BACKUP_VERIFY_AFTER_RUN=true
# HAMS_ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...
# HAMS_ALERT_5XX_THRESHOLD=15
# HAMS_ALERT_5XX_WINDOW_SEC=300
# HAMS_ALERT_COOLDOWN_SEC=600
# HAMS_ALERT_ON_SHUTDOWN=false
# HAMS_MONITORING_ENABLED=true
# HAMS_SLOW_REQUEST_MS=3000
# HAMS_DB_SLOW_QUERY_MS=0
# HAMS_BCRYPT_ROUNDS=12
# Emergency maintenance (503 except /health/*):
# HAMS_MAINTENANCE_MODE=false
# HAMS_MAINTENANCE_MESSAGE=HAMS is temporarily unavailable for scheduled maintenance.
