# Railway → Service → Variables (Production). Copy values; generate secrets locally.
NODE_ENV=production
# Railway sets PORT automatically — do not hardcode in the dashboard.
DATABASE_URL=${{Postgres.DATABASE_URL}}
JWT_SECRET=<random-32-chars-minimum>
HAMS_ENCRYPTION_KEY=<random-32-chars-minimum>
FRONTEND_URL=https://hams.hawanaairways.com,https://hams-frontend.vercel.app
