# Railway → backend service → Variables (required for production start).
# Paste each NAME = VALUE in the dashboard, then Redeploy the backend service.
NODE_ENV=production
DATABASE_URL=${{Postgres.DATABASE_URL}}
JWT_SECRET=<min 32 characters — set in Railway dashboard only, never commit real value>
HAMS_ENCRYPTION_KEY=<min 32 characters — required after JWT_SECRET>
FRONTEND_URL=https://hams.hawanaairways.com,https://hams-frontend.vercel.app
# Railway injects PORT — do not set PORT manually.
